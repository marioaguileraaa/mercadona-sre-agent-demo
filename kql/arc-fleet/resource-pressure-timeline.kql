// Log Analytics: law-arcbox-demo-001. Fictional technical SRE demo; role labels are synthetic.
// Five-minute CPU and memory pressure timeline used to prove an incident window and to show the
// return to the documented baseline after recovery.
let FleetResourceIds = dynamic([
  "/subscriptions/5305e853-a63b-4b82-9a3f-6fde18c1a798/resourcegroups/rg-arcbox-itpro-weu-002/providers/microsoft.hybridcompute/machines/arcbox-win2k22",
  "/subscriptions/5305e853-a63b-4b82-9a3f-6fde18c1a798/resourcegroups/rg-arcbox-itpro-weu-002/providers/microsoft.hybridcompute/machines/arcbox-win2k25",
  "/subscriptions/5305e853-a63b-4b82-9a3f-6fde18c1a798/resourcegroups/rg-arcbox-itpro-weu-002/providers/microsoft.hybridcompute/machines/arcbox-sql",
  "/subscriptions/5305e853-a63b-4b82-9a3f-6fde18c1a798/resourcegroups/rg-arcbox-itpro-weu-002/providers/microsoft.hybridcompute/machines/arcbox-ubuntu-01",
  "/subscriptions/5305e853-a63b-4b82-9a3f-6fde18c1a798/resourcegroups/rg-arcbox-itpro-weu-002/providers/microsoft.hybridcompute/machines/arcbox-ubuntu-02"
]);
InsightsMetrics
| where TimeGenerated >= ago(4h)
| where set_has_element(FleetResourceIds, tolower(_ResourceId))
| where (Namespace == "Processor" and Name == "UtilizationPercentage")
    or (Namespace == "Memory" and Name == "AvailableMB")
| extend TotalMemoryMB = todouble(parse_json(Tags)["vm.azm.ms/memorySizeMB"])
| extend Metric = iff(Namespace == "Processor", "CpuPercent", "MemoryUsedPercent")
| extend Value = iff(
    Namespace == "Processor",
    Val,
    iff(isnotnull(TotalMemoryMB) and TotalMemoryMB > 0, (TotalMemoryMB - Val) * 100.0 / TotalMemoryMB, real(null)))
| where isnotnull(Value)
| summarize Percent = round(avg(Value), 1)
    by Series = strcat(tostring(split(tolower(_ResourceId), "/")[-1]), " ", Metric), bin(TimeGenerated, 5m)
| order by TimeGenerated asc, Series asc
